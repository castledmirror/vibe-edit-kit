#!/usr/bin/env bash
# vibe-edit "<footage folder, video file or link>": finished vertical clips.
if [ -z "${1:-}" ]; then echo "usage: vibe-edit \"<footage folder, file or link>\""; exit 1; fi
command -v claude >/dev/null 2>&1 || { echo "Claude Code not found. Install it from https://claude.com/claude-code"; exit 1; }
exec claude "Use the Vibe Edit Kit to turn this into finished, captioned vertical clips, then tell me where they were delivered: $*"
